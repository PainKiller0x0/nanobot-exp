{
  "nanobot_config_path": "/root/.nanobot/config.json",
  "verify_url": "http://172.17.0.1:8092/verify",
  "state_file": "/root/.nanobot/workspace/skills/notify-sidecar-rs/data/state.json",
  "text_chunk_max_len": 1200,
  "target_kind": "c2c",
  "target_id": "REPLACE_WITH_QQ_OPENID_OR_GROUP_ID",
  "jobs": [
    {
      "id": "example-health",
      "name": "Example health check",
      "enabled": true,
      "schedule": "0 9 * * *",
      "timezone": "Asia/Shanghai",
      "command": "printf 'Nanobot notify-sidecar example OK\\n'",
      "timeout_secs": 30
    },
    {
      "id": "example-lof-report",
      "name": "Example LOF report",
      "enabled": false,
      "schedule": "45 9 * * 1-5",
      "timezone": "Asia/Shanghai",
      "command": "python3 /root/.nanobot/workspace/skills/qdii-monitor/send_qq.py 早市",
      "timeout_secs": 180
    },
    {
      "id": "personal-night-brief",
      "name": "个人副驾驶：睡前收束",
      "enabled": false,
      "schedule": "35 23 * * *",
      "timezone": "Asia/Shanghai",
      "command": "python3 /root/.nanobot/workspace/skills/personal-ops-assistant/copilot.py night",
      "timeout_secs": 30
    },
    {
      "id": "personal-weekly-review",
      "name": "个人副驾驶：自省周报",
      "enabled": false,
      "schedule": "30 22 * * 0",
      "timezone": "Asia/Shanghai",
      "command": "python3 /root/.nanobot/workspace/skills/personal-ops-assistant/copilot.py weekly",
      "timeout_secs": 30
    },
    {
      "id": "ops-guard-heal",
      "name": "Nanobot 服务自愈巡检",
      "enabled": false,
      "schedule": "*/5 * * * *",
      "timezone": "Asia/Shanghai",
      "command": "/root/nanobot-ops/scripts/nanobot-ops-guard.py --mode heal",
      "timeout_secs": 90
    },
    {
      "id": "ops-guard-upstream",
      "name": "Nanobot 上游版本通知",
      "enabled": false,
      "schedule": "30 10 * * 1",
      "timezone": "Asia/Shanghai",
      "command": "/root/nanobot-ops/scripts/nanobot-ops-guard.py --mode upstream",
      "timeout_secs": 45
    },
    {
      "id": "ops-guard-health-daily",
      "name": "Nanobot 每日健康汇报",
      "enabled": false,
      "schedule": "5 9 * * *",
      "timezone": "Asia/Shanghai",
      "command": "/root/nanobot-ops/scripts/nanobot-ops-guard.py --mode heal --force-report",
      "timeout_secs": 90
    },
    {
      "id": "ops-guard-obp-budget",
      "name": "OBP 月预算告警",
      "enabled": false,
      "schedule": "10 9,21 * * *",
      "timezone": "Asia/Shanghai",
      "command": "NANOBOT_OBP_MONTHLY_BUDGET_CNY=${NANOBOT_OBP_MONTHLY_BUDGET_CNY:-10} /root/nanobot-ops/scripts/nanobot-ops-guard.py --mode obp-budget",
      "timeout_secs": 45
    }
  ]
}
